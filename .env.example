# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── URLs / origins ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────────
# Project settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Storage bucket name for media/resume/certificates
SUPABASE_STORAGE_BUCKET=media

# ─── Admin auth (single identity) ───────────────────────────────────────
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',12))"
ADMIN_PASSWORD_HASH=$2a$12$replace_with_a_real_bcrypt_hash
# openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-random-hex
# Shared secret the API uses to trigger Next.js revalidation
REVALIDATE_SECRET=replace-with-random-string
